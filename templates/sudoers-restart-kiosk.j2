# {{ ansible_managed }}
# Lets the cabinet user restart its own kiosk session (autologin on tty1), e.g. after a MAUI
# update from the BO. Exact commands only, no wildcard: must match maui's src/class/KioskRestart.ts.
{{ kiosk_user }} ALL=(root) NOPASSWD: /usr/bin/systemctl restart getty@tty1, /usr/bin/systemctl reset-failed getty@tty1
